setup_zram() {
        banner "Setting up ZRAM swap..."

        sudo pacman -S --noconfirm --needed zram-generator

        # zram-generator creates and starts systemd-zram-setup@zram0.service by
        # itself, so there is no unit to write or enable here.
        #
        # The 4096 cap matters on the QEMU desktop: reserving 1G hugepages takes
        # RAM out of the normal allocator, so an uncapped "ram / 2" sized against
        # the full 16G would be far too large for the ~6G the host is left with.
        #
        # The swap partition is deliberately left alone. swap-priority 100 puts
        # zram in front of it, so the disk is only touched once zram is full, and
        # hibernation keeps working: install bakes resume=<swapdev> into
        # /etc/kernel/cmdline and the kernel cannot hibernate to zram.
        sudo tee /etc/systemd/zram-generator.conf >/dev/null <<'EOT'
[zram0]
zram-size = min(ram / 2, 4096)
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOT

        # The kernel defaults are tuned for swap on a spinning disk. zram is
        # orders of magnitude faster, so without these it barely gets used.
        sudo tee /etc/sysctl.d/99-vm-zram-parameters.conf >/dev/null <<'EOT'
vm.swappiness = 180
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.page-cluster = 0
EOT

        # zswap sits in front of zram and compresses pages before they ever reach
        # it, which leaves zram mostly unused. Turning it off at runtime is too
        # late, it has to be off from boot.
        if ! grep -q 'zswap.enabled=0' /etc/kernel/cmdline; then
                sudo sed -i 's/$/ zswap.enabled=0/' /etc/kernel/cmdline
                sudo mkinitcpio -P
        fi

        sudo systemctl daemon-reload
        sudo sysctl --system >/dev/null
        sudo systemctl start systemd-zram-setup@zram0.service

        ui_msg "ZRAM" "ZRAM swap is active now, and comes up on its own at every boot.\n\nIt is sized at half your memory and sits in front of the swap partition, which is left enabled so that hibernation still works.\n\nCheck it with 'zramctl' and 'swapon --show'. The zswap change only takes effect after a reboot."
}

