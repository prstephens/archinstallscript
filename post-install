VERSION="2"
BACKTITLE="Arch Installer v"$VERSION
BASE_URL="https://raw.githubusercontent.com/prstephens/archinstallscript/master/"

rootdev=/root/dev # changed on the fly during install
TLP=0             # changed on the fly during install
MAC=0             # changed on the fly during install

theme="light"

set -o pipefail
#set -x #toggle for debug. Will print all commands.

# Status markers shown against each menu entry. Deliberately ASCII, to match
# the installer and because the console font has no glyph for a tick.
MARK_DONE="[*]"
MARK_TODO="[ ]"
MARK_NEXT="[>]"

#   ============ UI HELPERS ========
#
#   Consistent dialogs, matching the
#   installer
#
#   ================================

ui_msg() {
        whiptail --backtitle "${BACKTITLE}" --title "$1" --fb --msgbox "$2" 0 78
}

ui_error() {
        whiptail --backtitle "${BACKTITLE}" --title "$1" --fb --msgbox "$2" 0 78
}

yesno() {
        local title="$1"
        local message="$2"
        whiptail --backtitle "${BACKTITLE}" --title "${title}" --fb --yesno "${message}" --defaultno 0 78
}

# Clears the screen and prints a banner before a long-running command.
# pacman, yay and makepkg deliberately run on the raw console rather than
# behind a --gauge: hiding a failed AUR build behind a spinner is what makes
# it impossible to diagnose.
banner() {
        clear
        echo "=============================================================================="
        echo "  $1"
        echo "=============================================================================="
        echo
}

preflight() {
        # whiptail drives every prompt here. On the installed system it is only
        # a transitive dependency, so it can legitimately be absent.
        if ! command -v whiptail >/dev/null 2>&1; then
                echo "whiptail is missing. Installing libnewt..." >&2
                sudo pacman -Sy --noconfirm libnewt || {
                        echo "Could not install libnewt - cannot show the menu." >&2
                        exit 1
                }
        fi

        if ! ping -q -w1 -c1 google.com >/dev/null 2>&1; then
                ui_error "No Network Connection" \
                        "You need to be connected to the Internet.\n\nEverything here is downloaded as it runs, so nothing can be installed without it."
                exit 1
        fi
}

#   ============ STATE =============
#
#   The menu reports what is actually on
#   the system rather than what this run
#   has done, so the markers stay right
#   across a reboot and a second run
#
#   ================================

has_pkg() {
        pacman -Qq "$1" >/dev/null 2>&1
}

# Names the installed desktop, or prints nothing. First match wins, and the
# themed variants are checked before the plain one they are built on.
desktop_installed() {
        if has_pkg gnome-shell; then
                if [[ -d "$HOME"/.themes/MacTahoe-Light || -d "$HOME"/.themes/MacTahoe-Dark ]]; then
                        printf 'GNOME, with the Mac OS theme'
                else
                        printf 'GNOME'
                fi
        elif has_pkg xfwm4; then
                if has_pkg xfce-winxp-tc-git; then
                        printf 'XFCE, themed as Windows XP'
                elif [[ -d /usr/share/plymouth/themes/Chicago95 ]]; then
                        printf 'XFCE, themed as Windows 95'
                else
                        printf 'XFCE'
                fi
        elif has_pkg plasma-desktop; then
                printf 'KDE Plasma'
        elif has_pkg hyprland; then
                printf 'Hyprland, with the HyDE configs'
        fi
}

# Names the screensaver that is set up, or prints nothing
screensaver_installed() {
        if has_pkg wscreensavers; then
                printf 'GLMatrix, on Wayland'
        elif [[ -f "$HOME"/.xscreensaver ]]; then
                printf 'GLMatrix, on X11'
        fi
}

# Renders the status marker for each menu entry
step_mark() {
        case "$1" in
                desktop)
                        [[ -n "$(desktop_installed)" ]] && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_NEXT}"
                        ;;
                apps)
                        has_pkg google-chrome && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_TODO}"
                        ;;
                screensaver)
                        [[ -n "$(screensaver_installed)" ]] && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_TODO}"
                        ;;
                adaway)
                        [[ -f /usr/bin/adaway ]] && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_TODO}"
                        ;;
                warp)
                        has_pkg cloudflare-warp-bin && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_TODO}"
                        ;;
                zram)
                        [[ -f /etc/systemd/zram-generator.conf ]] && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_TODO}"
                        ;;
                qemu)
                        has_pkg virt-manager && printf '%s' "${MARK_DONE}" || printf '%s' "${MARK_TODO}"
                        ;;
        esac
}

show_help() {
        ui_msg "How This Menu Works" \
"Work down the menu. Entries marked ${MARK_DONE} are already on the system,
${MARK_TODO} are outstanding, and ${MARK_NEXT} is the one to do next.

The markers are read from the system itself rather than from what this run
has done, so they stay correct if you reboot and come back.

  DESKTOP       Pick one desktop. Each choice also pulls in the base
                packages, fonts, firewall and screensaver, so this is
                the only entry that really needs running.

  APPLICATIONS  Browser, office, media, photos and a few extras.

  SCREENSAVER   GLMatrix on a 10 minute timeout. Wayland desktops get
                wscreensavers, XFCE gets xscreensaver. DESKTOP already
                picks the right one, so this is only to redo or change it.

  ADAWAY        Blocks ads for everything on the machine by rewriting
                /etc/hosts, refreshed weekly by a systemd timer.

  WARP          Cloudflare WARP, which is a free VPN of sorts.

  ZRAM          Compressed swap in RAM, sized to half your memory, put in
                front of the swap partition rather than replacing it so
                that hibernation still works.

  QEMU          QEMU/KVM with PCI passthrough. Rebuilds the initramfs
                and the GRUB config.

Everything here is downloaded as it runs, so all of it needs a network.

This menu opens on its own only on your first login. Quitting is safe, and
you can bring it back at any time by running ./post-install."
}

mainmenu() {
        local nextitem="${1:-.}" # Default to "." if no argument is provided
        local sel options desktop saver

        while true; do
                # Rebuilt every pass so the markers and summaries stay current
                desktop="$(desktop_installed)"
                saver="$(screensaver_installed)"

                options=(
                        "DESKTOP"      "$(step_mark desktop)  ${desktop:-Pick a desktop - start here}"
                        "APPLICATIONS" "$(step_mark apps)  Browser, office, media and photo apps"
                        "SCREENSAVER"  "$(step_mark screensaver)  ${saver:-GLMatrix, on a 10 minute timeout}"
                        "ADAWAY"       "$(step_mark adaway)  Block ads everywhere, refreshed weekly"
                        "WARP"         "$(step_mark warp)  Cloudflare WARP (poor man's VPN)"
                        "ZRAM"         "$(step_mark zram)  Compressed swap in RAM, half your memory"
                        "QEMU"         "$(step_mark qemu)  QEMU/KVM virtualisation"
                        ""             ""
                        "HELP"         "     What each step does"
                        "FINISH"       "     Reboot into the finished system"
                )

                # Exit must not drop straight out. This menu normally only opens on
                # first login, so an accidental Esc is expensive.
                if ! sel=$(whiptail --backtitle "${BACKTITLE}" --title "Arch Linux Post Installer" --menu "" \
                        --fb --cancel-button "Exit" --default-item "${nextitem}" 0 78 0 "${options[@]}" \
                        3>&1 1>&2 2>&3); then
                        if yesno "Quit?" "Leave the post installer?\n\nNothing already installed is undone. This menu will not open again on its own, but you can run ./post-install whenever you like."; then
                                clear
                                return 0
                        fi
                        continue
                fi

                case "${sel}" in
                "DESKTOP")
                        desktopmenu
                        nextitem="APPLICATIONS"
                        ;;
                "APPLICATIONS")
                        install_apps
                        nextitem="SCREENSAVER"
                        ;;
                "SCREENSAVER")
                        screensavermenu
                        nextitem="ADAWAY"
                        ;;
                "ADAWAY")
                        setup_adaway
                        nextitem="WARP"
                        ;;
                "WARP")
                        setup_cloudflare_warp
                        nextitem="ZRAM"
                        ;;
                "ZRAM")
                        setup_zram
                        nextitem="QEMU"
                        ;;
                "QEMU")
                        install_qemu
                        nextitem="FINISH"
                        ;;
                "HELP")
                        show_help
                        nextitem="HELP"
                        ;;
                "FINISH")
                        finish
                        nextitem="FINISH"
                        ;;
                esac
        done
}

desktopmenu() {
        local sel options

        options=(
                "GNOME"        "Vanilla GNOME"
                "GNOME MAC OS" "GNOME with the Mac OS theme, icons and wallpapers"
                "PLASMA"       "KDE Plasma"
                "CHICAGO95"    "XFCE themed as Windows 95"
                "WINDOWS XP"   "XFCE with the iconic Windows XP theme"
                "HYDE"         "Hyprland and configs which will blow your mind!"
        )

        if ! sel=$(whiptail --backtitle "${BACKTITLE}" --title "Choose A Desktop" --menu \
                "\nEach choice also installs the base packages, fonts, firewall and screensaver.\n" \
                --fb --cancel-button "Back" --default-item "." 0 78 0 "${options[@]}" \
                3>&1 1>&2 2>&3); then
                return 0
        fi

        # Installing a second desktop over the top mostly works, but it appends to
        # ~/.bash_profile again and re-runs the theme installers, so make it a
        # deliberate choice rather than a stray keypress.
        if [[ -n "$(desktop_installed)" ]]; then
                if ! yesno "Desktop Already Installed" \
                        "$(desktop_installed) is already installed.\n\nInstall ${sel} over the top?"; then
                        return 0
                fi
        fi

        case "${sel}" in
        "GNOME")
                install_gnome
                ;;
        "GNOME MAC OS")
                install_gnome
                install_gnome_mac
                ;;
        "PLASMA")
                install_plasma
                ;;
        "CHICAGO95")
                install_xfce
                install_chicago95
                ;;
        "WINDOWS XP")
                install_xfce
                install_xp
                apply_xp_theme
                ;;
        "HYDE")
                install_hyde
                ;;
        esac
}

# DESKTOP already sets the right one up. This is only to redo it, or to switch
# between the Wayland and X11 versions by hand.
screensavermenu() {
        local sel

        if ! sel=$(whiptail --backtitle "${BACKTITLE}" --title "Screensaver" --menu \
                "\nGLMatrix on a 10 minute timeout.\n" \
                --fb --cancel-button "Back" --default-item "." 0 78 0 \
                "WAYLAND" "wscreensavers - GNOME, Plasma and Hyprland" \
                "X11"     "xscreensaver - XFCE" \
                3>&1 1>&2 2>&3); then
                return 0
        fi

        case "${sel}" in
        "WAYLAND")
                apply_wscreensavers
                ;;
        "X11")
                apply_xscreensavers
                ;;
        esac
}

finish() {
        local desktop
        desktop="$(desktop_installed)"

        if [[ -z "${desktop}" ]]; then
                if ! yesno "No Desktop Installed" \
                        "No desktop has been installed, so there is nothing to reboot into yet.\n\nReboot anyway?"; then
                        return 0
                fi
        elif ! yesno "Reboot Now?" \
                "${desktop} is installed and its display manager is enabled.\n\nReboot into it now?"; then
                return 0
        fi

        # ~/.bashrc removes ~/newbie after post-install returns. Rebooting from
        # here never gets back to it, so clear it now or this menu reopens on
        # every login until the file is deleted by hand.
        rm -f "$HOME"/newbie

        banner "Rebooting..."
        sudo reboot
}

install_base_packages() {
        sudo pacman -S --noconfirm --needed xscreensaver firefox sassc gparted code meld pavucontrol mission-center
        yay -S --noconfirm --needed snapper-gui-git rar btrfs-assistant localsend-bin
}

install_fonts() {
        banner "Installing fonts..."
        yay -S --noconfirm --needed apple-fonts ttf-cascadia-code-nerd ttf-croscore ttf-google-sans

        [[ ! -d "$HOME"/.local/share/fonts ]] && mkdir -p "$HOME"/.local/share/fonts
        curl -sL "$BASE_URL"/fonts/HelveticaNeueLt.ttf -o "$HOME"/.local/share/fonts/HelveticaNeueLt.ttf
        curl -sL "$BASE_URL"/fonts/acorn/bedstead.otf -o "$HOME"/.local/share/fonts/bedstead.otf

        echo "Windows fonts..."
        #yay -S ttf-ms-win11-auto
        install_windows_11_fonts

        # disable all bitmap font rendering
        [[ ! -d "$HOME"/.config/fontconfig/conf.d ]] && mkdir -p "$HOME"/.config/fontconfig/conf.d
        cat <<EOT >"$HOME"/.config/fontconfig/conf.d/20-no-embedded.conf
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <match target="font">
    <edit name="embeddedbitmap" mode="assign">
      <bool>false</bool>
    </edit>
  </match>
</fontconfig>
EOT
        fc-cache -f
}

install_windows_11_fonts() {
        curl -sL $BASE_URL/fonts/win/windowsfonts.tar.gz.partaa -o /tmp/windowsfonts.tar.gz.partaa
        curl -sL $BASE_URL/fonts/win/windowsfonts.tar.gz.partab -o /tmp/windowsfonts.tar.gz.partab
        curl -sL $BASE_URL/fonts/win/windowsfonts.tar.gz.partac -o /tmp/windowsfonts.tar.gz.partac
        curl -sL $BASE_URL/fonts/win/windowsfonts.tar.gz.partad -o /tmp/windowsfonts.tar.gz.partad
        curl -sL $BASE_URL/fonts/win/windowsfonts.tar.gz.partae -o /tmp/windowsfonts.tar.gz.partae

        cat /tmp/windowsfonts.tar.gz.parta* >/tmp/windowsfonts.tar.gz

        sudo tar -zxvf /tmp/windowsfonts.tar.gz -C /

        fc-cache -f
}

install_gnome() {
        banner "Installing GNOME..."

        install_base_packages

        sudo pacman -S --noconfirm --needed gnome gnome-tweaks file-roller gnome-terminal
        yay -S --noconfirm --needed extension-manager

        install_fonts

        apply_wscreensavers

        # add arch updater extension
        yay -S --noconfirm --needed gnome-shell-extension-arch-update
        gsettings set org.gnome.shell.extensions.arch-update check-cmd "/bin/sh -c \"(/usr/bin/checkupdates; /usr/bin/yay -Qqu --color never | sed 's/Get .*//') | sort -u -t' ' -k1,1\""
        gsettings set org.gnome.shell.extensions.arch-update update-cmd 'gnome-terminal -- bash -c "yay; echo Done - Press enter to exit; read"'
        gsettings set org.gnome.shell.extensions.arch-update use-buildin-icons true
        gsettings set org.gnome.shell.extensions.arch-update strip-versions true
        gsettings set org.gnome.shell disable-extension-version-validation "true"

        # set the keyboard layout
        if [[ "$MAC" -eq 1 ]]; then
                gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'gb+mac')]"
        else
                gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'gb')]"
        fi

        # if we are a laptop, add the hibernate option in the power menu
        if [[ "$TLP" -eq 1 ]]; then
                git clone --depth 1 https://github.com/arelange/gnome-shell-extension-hibernate-status.git /tmp/gnome-shell-extension-hibernate-status
                cp -r /tmp/gnome-shell-extension-hibernate-status "$HOME"/.local/share/gnome-shell/extensions/hibernate-status\@dromi
                gnome-extensions enable hibernate-status@dromi
        fi

        # Turn on some extensions
        gnome-extensions enable arch-update@RaphaelRochet

        gsettings set org.gnome.mutter center-new-windows true
        gsettings set org.gnome.shell always-show-log-out true

        # Remove some trash from Gnome
        sudo pacman -Rs --noconfirm epiphany gnome-music showtime gnome-connections gnome-text-editor gnome-tour gnome-console gnome-user-docs yelp gnome-maps decibels

        
        cat <<EOT >>"$HOME"/.bash_profile
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    export MOZ_ENABLE_WAYLAND=1
fi
EOT
        install_ufw

        sudo systemctl enable gdm

        # create a snapshot
        for i in $(seq 2 50); do sudo snapper delete "$i"; done
        sudo snapper -c root create --description "### FRESH INSTALL - Including Gnome ###" # ID 2

        # Change Google Drive name in Nautilus sidebar
        # ~/.config/goa-1.0/accounts.conf
        # PresentationIdentity=Google Drive
}

install_ufw() {
        sudo pacman -S --noconfirm --needed ufw gufw
        sudo systemctl enable ufw.service

        sudo ufw default deny
        sudo ufw allow from 192.168.1.0/24
        sudo ufw limit ssh
        sudo ufw logging off

        sudo ufw enable
}

apply_xscreensavers() {
        # xscreensaver settings - 10 min timeout - GL matrix
        # X11 sessions only, so XFCE (Chicago95 / Windows XP). GNOME and Plasma are
        # Wayland only now and use apply_wscreensavers instead.
        curl -sL "$BASE_URL"/configs/home/.xscreensaver -o "$HOME"/.xscreensaver
        if [ ! -d "$HOME"/.config/autostart/ ]; then mkdir "$HOME"/.config/autostart; fi
        curl -sL "$BASE_URL"/configs/home/xscreensaver.desktop -o "$HOME"/.config/autostart/xscreensaver.desktop
}

apply_wscreensavers() {
        # Wayland equivalent of apply_xscreensavers - 10 min timeout - GL matrix.
        # Used by GNOME, Plasma and Hyde. The xscreensaver package stays installed in
        # install_base_packages because this runs its real hack binaries from
        # /usr/lib/xscreensaver, it just drives them over wlr-layer-shell instead.
        yay -S --noconfirm --needed wscreensavers jq

        [[ ! -d "$HOME"/.config/wscreensavers ]] && mkdir -p "$HOME"/.config/wscreensavers

        # wscreensavers marshals its entire config struct back to disk on every change,
        # so the real file is huge - every saver's parameters, the enabled pool, the
        # per-monitor assignments. Patch the handful of keys we care about rather than
        # overwriting it, or re-running this from the menu wipes all of that. A key that
        # is absent is not a problem: the file is unmarshalled over DefaultConfig(), so
        # anything we leave out keeps the package default.
        #
        # preferNativeOverX11 MUST stay false. While it is true, wscreensavers rewrites
        # any "xss_<name>" id back to its own WebGL2 reimplementation on every config
        # load and save, so selecting the real /usr/lib/xscreensaver/glmatrix never
        # sticks and the blurry in-browser port is what actually runs.
        local cfg="$HOME"/.config/wscreensavers/config.json
        [[ -f "$cfg" ]] || echo '{}' >"$cfg"
        jq '.mode = "single"
                | .selectedSaver = "xss_glmatrix"
                | .preferNativeOverX11 = false
                | .idleTimeoutMinutes = 10
                | .lockEnabled = false
                | .xssMaxStreamDim = 3840' "$cfg" >"$cfg".new && mv "$cfg".new "$cfg"

        # suppress the donation reminder on every start
        echo '{"supported": true, "isLifetime": true}' >"$HOME"/.config/wscreensavers/support.json

        systemctl --user enable wscreensavers.service
}

install_dash_to_dock() {
        # add dash to dock extension
        git clone --depth 1 https://github.com/prstephens/dash-to-dock.git /tmp/dash-to-dock
        cd /tmp/dash-to-dock || return 1

        make
        make install

        curl -sL $BASE_URL/configs/extensions/dash-to-dock-settings -o /tmp/dash-to-dock-settings
        dconf load /org/gnome/shell/extensions/dash-to-dock/ </tmp/dash-to-dock-settings
}

install_plymouth() {

        if ! pacman -Qs plymouth >/dev/null; then
                sudo pacman -S --noconfirm --needed plymouth

                sudo sed -i 's/quiet/quiet splash/' /etc/kernel/cmdline
                
                sudo sed -i 's/systemd/systemd plymouth/' /etc/mkinitcpio.conf
                sudo mkinitcpio -P
        fi
}

apply_plymouth_mac() {
        git clone --depth 1 https://github.com/fathyar/mac-plymouth.git /tmp/mac-plymouth
        sudo cp -r /tmp/mac-plymouth/mac/ /usr/share/plymouth/themes/
        sudo plymouth-set-default-theme -R mac
}

apply_plymouth_xp() {
        sudo plymouth-set-default-theme -R bootvid
}

apply_plymouth_chicago(){
        sudo plymouth-set-default-theme -R Chicago95
}

install_gnome_mac() {
        install_apps

        # copy some custom "apps"
        if [ ! -d "$HOME"/.local/share/applications/ ]; then mkdir "$HOME"/.local/share/applications; fi
        curl -sL "$BASE_URL"/scripts/maps.desktop -o  "$HOME"/.local/share/applications/maps.desktop

        # Remove 'Utilities' folder in app grid so all apps are in view
        gsettings set org.gnome.desktop.app-folders folder-children "['YaST']"

        # pin some nice favourites to the dash
        gsettings set org.gnome.shell favorite-apps "['org.gnome.Nautilus.desktop', 'google-chrome.desktop', 'elecwhat.desktop', 'org.gnome.Geary.desktop', 'maps.desktop', 'org.gnome.Photos.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.Todo.desktop', 'org.gnome.Notes.desktop', 'spotify-launcher.desktop', 'libreoffice-impress.desktop', 'libreoffice-calc.desktop', 'libreoffice-writer.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']"

        # install dash to dock extension
        install_dash_to_dock

        # install the Mac theme set
        install_tahoe

        # blur my shell
        git clone --depth 1 https://github.com/aunetx/blur-my-shell /tmp/blur-my-shell
        cd /tmp/blur-my-shell || return 1
        make install

        # panel corners
        git clone --depth 1 https://github.com/aunetx/panel-corners.git /tmp/panel-corners
        cd /tmp/panel-corners || return 1
        make install

        # logo menu
        git clone --depth 1 https://github.com/Aryan20/Logomenu.git /tmp/logo-menu
        cd /tmp/logo-menu || return 1
        make install

        # kiwi
        git clone --depth 1 https://github.com/kem-a/kiwi-kemma.git /tmp/kiwi
        cp -r /tmp/kiwi "$HOME"/.local/share/gnome-shell/extensions/kiwi@kemma

        # get the tahoe theme for gnome-terminal
        curl -sL $BASE_URL/configs/gnome-terminal-profile-tahoe.dconf -o /tmp/gnome-terminal-profile-tahoe.dconf
        dconf load /org/gnome/terminal/legacy/profiles:/ < /tmp/gnome-terminal-profile-tahoe.dconf

        # plymouth macos loading theme
        install_plymouth
        apply_plymouth_mac

        curl -sL $BASE_URL/configs/extensions/blur-my-shell-settings -o /tmp/blur-my-shell-settings
        curl -sL $BASE_URL/configs/extensions/panel-corners-settings -o /tmp/panel-corners-settings
        curl -sL $BASE_URL/configs/extensions/logo-menu-settings -o /tmp/logo-menu-settings
        curl -sL $BASE_URL/configs/extensions/kiwi-settings -o /tmp/kiwi-settings

        dconf load /org/gnome/shell/extensions/blur-my-shell/ </tmp/blur-my-shell-settings
        dconf load /org/gnome/shell/extensions/panel-corners/ </tmp/panel-corners-settings
        dconf load /org/gnome/shell/extensions/Logo-menu/ </tmp/logo-menu-settings
        dconf load /org/gnome/shell/extensions/kiwi/ </tmp/kiwi-settings

        gnome-extensions enable dash-to-dock@micxgx.gmail.com
        gnome-extensions enable blur-my-shell@aunetx
        gnome-extensions enable panel-corners@aunetx
        gnome-extensions enable logomenu@aryan_k
        gnome-extensions enable just-perfection-desktop@just-perfection
        gnome-extensions enable kiwi@kemma

        update_icons

        # set the macbook colour profile
        if [[ "$MAC" -eq 1 ]]; then
                ICC_PROFILE="/tmp/MacbookAir_Color_LCD.icc"
                PROFILE_ID=$(colormgr import-profile "$ICC_PROFILE")
                DEVICE_ID=$(colormgr get-devices-by-kind display | sed 's/Object Path:\s*//g' | head -n 1)
                colormgr device-add-profile "$DEVICE_ID" "$PROFILE_ID"
                colormgr device-make-profile-default "$DEVICE_ID" "$PROFILE_ID"
        fi
}

download_if_missing() {
    local url=$1
    local dest=$2

    if [ ! -f "$dest" ]; then
        echo "Downloading $(basename "$dest")..."
        curl -sL "$url" -o "$dest"
    else
        echo "File $(basename "$dest") already exists, skipping."
    fi
}

install_tahoe() {
        gsettings set org.gnome.desktop.interface clock-show-weekday true

        BASE_DIR="$HOME/.local/share/backgrounds"
        [[ ! -d "$BASE_DIR" ]] && mkdir mkdir -p "$BASE_DIR"

        # Define wallpapers
        declare -A wallpapers=(
                [ventura-light.jpg]="macos/ventura-light.jpg"
                [ventura-dark.jpg]="macos/ventura-dark.jpg"
                [monterey-light.jpg]="macos/monterey-light.jpg"
                [monterey-dark.jpg]="macos/monterey-dark.jpg"
                [bigsur-light.jpg]="macos/bigsur-light.jpg"
                [bigsur-dark.jpg]="macos/bigsur-dark.jpg"
                [sonoma-light.jpg]="macos/sonoma-light.jpg"
                [sonoma-dark.jpg]="macos/sonoma-dark.jpg"
                [sonoma-horizon.png]="macos/sonoma-horizon.png"
                [sequoia-light.jpg]="macos/sequoia-light.jpg"
